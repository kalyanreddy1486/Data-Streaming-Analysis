# =====================================================================
# REAL-TIME STREAMING ANALYTICS - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=smartmeter-events
KAFKA_CONSUMER_GROUP=smartmeter-processor-group

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smartmeter

# Dataset and Producer Pacing
DATASET_PATH=data/sample_data.csv
PRODUCER_INTERVAL_SEC=0.2
CONTINUOUS_REPLAY=True
ANOMALY_INTERVAL_MIN=20
ANOMALY_INTERVAL_MAX=30

# Machine Learning & Sliding Window
WINDOW_SIZE=30
MODEL_PATH=ml/anomaly_model.pkl
MODEL_METADATA_PATH=ml/model_metadata.json
IFOREST_CONTAMINATION=0.01
IFOREST_RANDOM_STATE=42

# Dashboard Configuration
DASHBOARD_REFRESH_INTERVAL_SEC=2
DASHBOARD_QUERY_LIMIT=120

# System Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
